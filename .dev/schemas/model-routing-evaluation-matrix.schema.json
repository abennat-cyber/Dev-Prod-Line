{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Routing Evaluation Matrix",
  "type": "object",
  "required": ["schema_version", "status", "criteria", "profile_mapping"],
  "properties": {
    "schema_version": { "type": "string" },
    "status": { "type": "string" },
    "criteria": { "type": "object", "minProperties": 1 },
    "profile_mapping": { "type": "array", "items": { "type": "object" } }
  }
}
